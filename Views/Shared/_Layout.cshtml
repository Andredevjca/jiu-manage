<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · JiuManager</title>
    <partial name="_Estilos" />
</head>
<body>
    <a class="skip-link" href="#app-page">Ir para o conteúdo</a>
    <aside class="sidebar" id="sidebar">
        <partial name="_Navegacao" />
    </aside>
    <button class="menu-overlay" aria-label="Fechar menu" tabindex="-1"></button>
    <div class="app-main">
        <header class="topbar">
            <div>
                <button class="icon-button menu-toggle" aria-label="Alternar menu" aria-controls="sidebar" aria-expanded="false"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
                <span class="breadcrumb-text">JiuManager <span>/</span> <strong>@ViewData["Title"]</strong></span>
            </div>
            <div class="topbar-direita">
                <span class="data-hoje">@DateTime.Today.ToString("dd 'de' MMMM, yyyy")</span>
                <a href="/Notificacoes" class="icon-button" aria-label="Notificações"><i class="fa-regular fa-bell" aria-hidden="true"></i></a>
                <a class="avatar" href="/Conta/Perfil" aria-label="Meu perfil">@(User.Identity?.Name?.FirstOrDefault().ToString() ?? "J")</a>
            </div>
        </header>
        <main class="conteudo" id="app-page" tabindex="-1">
            @if (TempData["Sucesso"] is string sucesso)
            {
                <div class="toast-meta" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> @sucesso<button class="fechar-toast icon-button" aria-label="Fechar">×</button></div>
            }
            @if (TempData["Erro"] is string erro)
            {
                <div class="alert alert-danger" role="alert">@erro</div>
            }
            @RenderBody()
        </main>
        <footer class="rodape"><span>JiuManager <span class="muted">· Sua equipe, em evolução.</span></span><small>Disciplina dentro e fora do tatame.</small></footer>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

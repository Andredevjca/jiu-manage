@inject CatalogoModulos Catalogo
@inject JiuManager.Services.PermissaoServico Permissoes
@inject JiuManager.Repositories.ConsultaRepositorio Consultas
@inject ContextoEquipe Contexto
@{
var autenticado=User.Identity?.IsAuthenticated==true;
var moduloAtual=ViewContext.RouteData.Values["controller"]?.ToString();
var aluno=User.IsInRole("Aluno");
var unidades=autenticado&&!aluno?await Consultas.ListarAsync("Unidades"):new List<Dictionary<string,object?>>();
var equipe=autenticado?(await Consultas.ListarAsync("Equipes")).FirstOrDefault()?.GetValueOrDefault("Nome")?.ToString():"JiuManager";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@(ViewData["Title"]??"Sua equipe, em evolução") · JiuManager</title>
<link rel="icon" href="/images/marca.svg" type="image/svg+xml"/>
<link href="/fonts/nunito.css" rel="stylesheet"/>
<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="/lib/fontawesome/css/all.min.css"/>
<link rel="stylesheet" href="/css/site.css" asp-append-version="true"/>
</head>
<body class="@(autenticado?"aplicacao":"pagina-publica")">
@if(autenticado){
<aside class="sidebar" id="sidebar">
<a class="marca" href="@(aluno?"/Portal":"/Dashboard")">
<span class="marca-simbolo">柔</span>
<span>Jiu<span class="marca-leve">Manager</span>
<small>EVOLUA SUA EQUIPE</small>
</span>
</a>
<div class="equipe-lateral">
<span class="avatar pequeno">@HelperFormatacao.Iniciais(equipe??"JM")</span>
<span>
<strong>@equipe</strong>
<small>Gestão da equipe</small>
</span>
<i class="fa-solid fa-chevron-down">
</i>
</div>
<nav aria-label="Menu principal">
@if(!aluno){<a class="item-menu @(moduloAtual=="Dashboard"?"selecionado":"")" href="/Dashboard">
<i class="fa-solid fa-chart-pie">
</i>
<span>Visão geral</span>
</a>}
@if(aluno){<a class="item-menu selecionado" href="/Portal">
<i class="fa-solid fa-user">
</i>Meu perfil</a>
<a class="item-menu" href="/Portal/Carteirinha">
<i class="fa-solid fa-id-card">
</i>Minha carteirinha</a>}
@foreach(var grupo in new[]{"Gestão","Treinamento","Financeiro","Configurações"}){
var visiveis=new List<Modulo>();foreach(var modulo in Catalogo.Todos.Where(m=>m.Grupo==grupo)){if(await Permissoes.PodeAsync(modulo.Plural,"visualizar"))visiveis.Add(modulo);}
if(visiveis.Count>0){<div class="rotulo-menu">@grupo</div>@foreach(var modulo in visiveis){<a class="item-menu @(moduloAtual==modulo.Plural?"selecionado":"")" href="/@modulo.Plural">
<i class="fa-solid fa-@modulo.Icone">
</i>
<span>@modulo.Titulo</span>@if(modulo.Plural=="Alunos"){<span class="ponto-menu">
</span>}</a>}if(grupo=="Financeiro"){<a class="item-menu" href="/Mensalidades?status=Atrasado">
<i class="fa-regular fa-clock">
</i>
<span>Inadimplência</span>
</a>}}
}
@if(await Permissoes.PodeAsync("Relatorios","visualizar")){<div class="rotulo-menu">Análise e documentos</div>
<a class="item-menu @(moduloAtual=="Relatorios"?"selecionado":"")" href="/Relatorios">
<i class="fa-solid fa-chart-column">
</i>Relatórios</a>}
@foreach(var item in new[]{("Certificados","Certificados","file-signature"),("Carteirinhas","Carteirinhas","id-card"),("Permissoes","Permissões","key")}){if(await Permissoes.PodeAsync(item.Item1,"visualizar")){<a class="item-menu @(moduloAtual==item.Item1?"selecionado":"")" href="/@item.Item1">
<i class="fa-solid fa-@item.Item3">
</i>@item.Item2</a>}}
</nav>
<div class="rodape-sidebar">
<span class="selo">柔</span>
<strong>Disciplina dentro e fora do tatame.</strong>
<small>JiuManager · Versão 1.0.0<br/>Gestão para equipes de Jiu-Jitsu</small>
</div>
</aside>
<div class="area-aplicacao">
<header class="barra-superior">
<button class="botao-icone" id="alternar-menu" aria-label="Recolher ou abrir menu">
<i class="fa-solid fa-bars-staggered">
</i>
</button>
<div class="contexto-equipe">
<small>EQUIPE</small>
<strong>@equipe</strong>
</div>
<div class="separador-vertical">
</div>@if(!aluno){<form action="/Contexto/Unidade" method="post" class="seletor-unidade">@Html.AntiForgeryToken()<input type="hidden" name="retorno" value="@Context.Request.Path@Context.Request.QueryString"/>
<i class="fa-solid fa-location-dot">
</i>
<select name="unidadeId" aria-label="Filtrar por unidade" data-enviar>
<option value="0">Todas as unidades</option>@foreach(var unidade in unidades){<option value="@unidade["Id"]" selected="@(Convert.ToInt32(unidade["Id"])==Contexto.UnidadeId)">@unidade["Nome"]</option>}</select>
</form>}<div class="usuario-topo">
<div>
<strong>@User.Identity?.Name</strong>
<small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
</div>
<a href="/Conta/Senha" class="avatar" title="Alterar senha">@HelperFormatacao.Iniciais(User.Identity?.Name??"JM")</a>
<form action="/Conta/Sair" method="post">@Html.AntiForgeryToken()<button class="botao-icone" title="Sair" aria-label="Sair">
<i class="fa-solid fa-arrow-right-from-bracket">
</i>
</button>
</form>
</div>
</header>
<main class="conteudo">@if(TempData["Sucesso"]!=null){<div class="alert alert-success">
<i class="fa-solid fa-circle-check me-2">
</i>@TempData["Sucesso"]</div>}@if(TempData["Erro"]!=null){<div class="alert alert-danger">@TempData["Erro"]</div>}@RenderBody()</main>
<footer class="rodape-pagina">© @DateTime.Today.Year JiuManager <span>Feito para quem vive o Jiu-Jitsu.</span>
</footer>
</div>
}else{@RenderBody()}
<script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts",required:false)</body>
</html>


@model JiuManager.Models.Usuario
@{Layout="_Layout"; ViewData["Title"]="Meu perfil";}
<div class="titulo-pagina">
    <div>
        <span class="eyebrow">MINHA CONTA</span>
        <h1>Meu perfil</h1>
        <p>Gerencie seus dados de acesso e preferências.</p>
    </div>
</div>
<div class="duas-colunas">
    <section class="painel">
        <h2>Dados pessoais</h2>
        <div class="linha-lista">
            <div class="flex-1">
                <strong>@Model?.Nome</strong>
                <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
            </div>
            <a class="avatar" style="width:50px;height:50px;font-size:16px;">@(Model?.Nome?.Substring(0,1)??"J")</a>
        </div>
        <div class="linha-lista">
            <strong>E-mail</strong>
            <small>@Model?.Email</small>
        </div>
    </section>
    <section class="painel">
        <h2>Segurança</h2>
        <div class="linha-lista">
            <div class="flex-1">
                <strong>Alterar senha</strong>
                <small>Atualize sua senha regularmente</small>
            </div>
            <a class="btn btn-outline-primary" href="/Conta/Senha">Alterar</a>
        </div>
    </section>
</div>
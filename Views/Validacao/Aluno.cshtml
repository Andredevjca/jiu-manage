@model Dictionary<string,object?>
@{Layout="_LayoutPublico";ViewData["Title"]="Validação de carteirinha";}
<section class="documento-publico painel">
<div class="marca">
<span class="marca-simbolo">柔</span>
<span>JiuManager</span>
</div>
<div class="icone-secao mx-auto mb-4">
<i class="fa-solid fa-shield-halved">
</i>
</div>
<h1 class="fs-4 mb-3">Carteirinha verificada</h1>
<p class="text-muted mb-4">Registro oficial da equipe @Model["Equipe"].</p>
<h2 class="fs-3 mb-3">@Model["Nome"]</h2>
<span class="status @(Model["Status"]?.ToString()=="Ativo"?"positivo":"neutro")">@Model["Status"]</span>
<dl class="row mt-4">
<div class="col-6">
<dt>FAIXA</dt>
<dd>@Model["Faixa"]</dd>
</div>
<div class="col-6">
<dt>GRAU</dt>
<dd>@Model["Grau"]</dd>
</div>
</dl>
<small class="text-muted">Situação consultada em @DateTime.Now.ToString("dd/MM/yyyy HH:mm").</small>
</section>
